#--------------------------------------------------------------------
# Pasa-Buy — PRODUCTION environment template
#--------------------------------------------------------------------
# Copy to `.env` in the project root ON THE SERVER (outside public/).
# Fill in real values there; never commit them. File mode 600.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Exact public URL with trailing slash. HTTPS only.
app.baseURL = 'https://REPLACE-WITH-DOMAIN/'
app.forceGlobalSecureRequests = true
# Only trust X-Forwarded-* from your own proxy/load balancer, e.g.
# app.proxyIPs.10.0.0.0/8 = X-Forwarded-For
# app.allowedHostnames.0 = 'www.REPLACE-WITH-DOMAIN'

#--------------------------------------------------------------------
# Database — dedicated database and least-privilege user:
#   GRANT SELECT, INSERT, UPDATE, DELETE ON pasabuy_prod.* TO 'pasabuy_app'@'host';
# Run migrations with a separate user that also has CREATE/ALTER/INDEX/
# REFERENCES/DROP, or grant them temporarily during a release.
#--------------------------------------------------------------------
database.default.hostname = REPLACE
database.default.database = pasabuy_prod
database.default.username = pasabuy_app
database.default.password = REPLACE-WITH-LONG-RANDOM-SECRET
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# Cookies / session
#--------------------------------------------------------------------
cookie.secure = true
cookie.httponly = true
cookie.samesite = Lax
session.cookieName = 'pasabuy_session'
session.expiration = 7200
session.regenerateDestroy = true

#--------------------------------------------------------------------
# Logging: 1-4 = emergency..error (no debug/info noise in production)
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# Pasa-Buy
#--------------------------------------------------------------------
# First release is a portfolio demo: keep demo mode ON.
pasabuy.demoMode = true

# Only if seeding demo accounts on this server (then remove it):
# DEMO_SEED_PASSWORD =

# PayMongo test keys (GCash/Maya) and TalkJS chat — see .env.example
# paymongo.secretKey = sk_test_
# paymongo.webhookSecret =
# talkjs.appId =
# talkjs.secretKey =
