#--------------------------------------------------------------------
# Pasa-Buy — STAGING environment template
#--------------------------------------------------------------------
# Same settings as production, but a separate URL, database and
# credentials, filled only with synthetic data (DemoSeeder).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://staging.REPLACE-WITH-DOMAIN/'
app.forceGlobalSecureRequests = true

database.default.hostname = REPLACE
database.default.database = pasabuy_staging
database.default.username = pasabuy_staging_app
database.default.password = REPLACE-WITH-DIFFERENT-SECRET
database.default.DBDriver = MySQLi
database.default.port = 3306

cookie.secure = true
cookie.httponly = true
cookie.samesite = Lax
session.cookieName = 'pasabuy_staging_session'
session.expiration = 7200
session.regenerateDestroy = true

logger.threshold = 4

pasabuy.demoMode = true

# Required when running DemoSeeder in production mode.
DEMO_SEED_PASSWORD = REPLACE-WITH-STAGING-DEMO-PASSWORD

# PayMongo test keys (GCash/Maya) and TalkJS chat — see .env.example
# paymongo.secretKey = sk_test_
# paymongo.webhookSecret =
# talkjs.appId =
# talkjs.secretKey =

#--------------------------------------------------------------------
# Xendit — GCash / Maya wallet top-ups (TEST keys only: xnd_development_...)
# Dashboard (Test mode) → Settings → API keys: secret key with Money-in
# write permission. Settings → Webhooks: copy the verification token and
# set the Payment Session URL to https://<host>/webhooks/xendit.
# Used instead of PayMongo when set. Xendit needs HTTPS return URLs; on
# localhost leave publicBaseUrl empty and use "Check payment" on the Wallet.
#--------------------------------------------------------------------
# xendit.secretKey = xnd_development_
# xendit.callbackToken =
# xendit.publicBaseUrl =
