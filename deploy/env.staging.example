#--------------------------------------------------------------------
# Pasa-Buy — STAGING environment template
#--------------------------------------------------------------------
# Same settings as production, but a separate URL, database and
# credentials, filled only with synthetic data (DemoSeeder).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://staging.REPLACE-WITH-DOMAIN/'
app.forceGlobalSecureRequests = true

database.default.hostname = REPLACE
database.default.database = pasabuy_staging
database.default.username = pasabuy_staging_app
database.default.password = REPLACE-WITH-DIFFERENT-SECRET
database.default.DBDriver = MySQLi
database.default.port = 3306

cookie.secure = true
cookie.httponly = true
cookie.samesite = Lax
session.cookieName = 'pasabuy_staging_session'
session.expiration = 7200
session.regenerateDestroy = true

logger.threshold = 4

pasabuy.demoMode = true

# Required when running DemoSeeder in production mode.
DEMO_SEED_PASSWORD = REPLACE-WITH-STAGING-DEMO-PASSWORD
