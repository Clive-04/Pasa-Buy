#--------------------------------------------------------------------
# Pasa-Buy — LOCAL DEVELOPMENT environment
#--------------------------------------------------------------------
# Copy to `.env` (never commit `.env`). Each environment has its own
# file and its own database:
#   local       -> this file                      (pasa_buy_db)
#   tests       -> database.tests.* below          (pasa_buy_test, TRUNCATED by PHPUnit)
#   staging     -> deploy/env.staging.example      (separate DB + URL)
#   production  -> deploy/env.production.example   (separate DB + URL)
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# XAMPP serves the project folder; the root .htaccess forwards into public/.
app.baseURL = 'http://localhost/Pasa-Buy-Project/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# Database (local)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = pasa_buy_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# Database (automated tests) — must contain "test"; it is wiped.
#--------------------------------------------------------------------
database.tests.hostname = 127.0.0.1
database.tests.database = pasa_buy_test
database.tests.username = root
database.tests.password =
database.tests.port = 3306

#--------------------------------------------------------------------
# Pasa-Buy settings (see app/Config/PasaBuy.php)
#--------------------------------------------------------------------
# Demo mode: wallet balances are simulated credits. Must stay true until a
# verified payment provider exists.
pasabuy.demoMode = true
# pasabuy.demoTopUpMaxCents = 500000
# pasabuy.demoWalletCapCents = 2000000
# pasabuy.notificationPollSeconds = 30

# Password for `php spark db:seed DemoSeeder` (local default: DemoPass#2026)
# DEMO_SEED_PASSWORD =

#--------------------------------------------------------------------
# PayMongo — GCash / Maya wallet top-ups (TEST keys only in this demo)
# Dashboard → Developers → API keys; webhook secret is shown when you add
# the endpoint  https://<host>/webhooks/paymongo  (event: checkout_session.payment.paid).
# Leave empty to use simulated demo credits instead.
#--------------------------------------------------------------------
# paymongo.secretKey = sk_test_
# paymongo.webhookSecret =

#--------------------------------------------------------------------
# TalkJS — hosted chat. Dashboard → Settings: copy App ID and secret key,
# enable authentication, and disable browser user/conversation sync.
# Leave empty to use the built-in database chat.
#--------------------------------------------------------------------
# talkjs.appId =
# talkjs.secretKey = sk_test_

#--------------------------------------------------------------------
# Xendit — GCash / Maya wallet top-ups (TEST keys only: xnd_development_...)
# Dashboard (Test mode) → Settings → API keys: secret key with Money-in
# write permission. Settings → Webhooks: copy the verification token and
# set the Payment Session URL to https://<host>/webhooks/xendit.
# Used instead of PayMongo when set. Xendit needs HTTPS return URLs; on
# localhost leave publicBaseUrl empty and use "Check payment" on the Wallet.
#--------------------------------------------------------------------
# xendit.secretKey = xnd_development_
# xendit.callbackToken =
# xendit.publicBaseUrl =
